.env
n8n/n8n_data/
freqtrade/user_data/logs/
freqtrade/user_data/data/
freqtrade/user_data/tradesv3.sqlite*
freqtrade/user_data/notebooks/
.claude/
freqtrade/user_data/models/

# --- FinBuddy Temp/Log Files ---
backtests/
*.log
freqtrade/user_data/tradesv3.dryrun.sqlite
freqtrade/user_data/_v21_overlay_*.json

# Brain temp configs — created per experiment by runner.py, auto-cleaned by finally block
freqtrade/user_data/tmp_brain_group_g*.json

# Dated pair-candidate snapshots — auto-generated, not useful in history
freqtrade/user_data/pair_candidates_*.json

# Backtest artifacts — never commit these (large binary files, machine-specific)
freqtrade/user_data/backtest_results/*.zip
freqtrade/user_data/backtest_results/*.meta.json
freqtrade/user_data/backtest_results/*.log
freqtrade/user_data/backtest_results/.last_result.json

# Python cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/

# OS
.DS_Store
Thumbs.db

# FreqAI model artifacts (large, regenerated each backtest)
freqtrade/user_data/models/**/*.pkl
freqtrade/user_data/models/**/*.backup.pkl

# FreqAI model artifacts (large, regenerated each backtest)
freqtrade/user_data/models/**/*.pkl
freqtrade/user_data/models/**/*.backup.pkl

# FreqAI runtime params (regenerated on every retrain)
freqtrade/user_data/models/**/run_params.json

# Executor runtime database
freqtrade/user_data/executor.sqlite
freqtrade/user_data/executor.sqlite-*
walkforward_results/
finbuddy_memory/historical/orderflow/

# Brain API secrets (Coinalyze etc.) — never commit
scripts/.secrets.env

# Config backups made by promote.py's apply_promotion() before each promotion —
# these are point-in-time snapshots for local rollback only, not history worth
# tracking (and pre-2026-07-05 ones contain real secrets baked in from before
# the api_server/telegram secrets were moved to freqtrade/.env).
freqtrade/user_data/config.json.bak-*

# MkDocs build output — regenerated from docs/*.md + docstrings, not source.
site/

# Arbitrage feed daemon's live price snapshot — rewritten every 5s, pure cache,
# zero historical value (unlike ledger.jsonl, which IS tracked as an audit trail).
finbuddy_memory/arbitrage/price_cache.json
