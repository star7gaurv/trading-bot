{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 8,
    "stake_currency": "USDT",
    "stake_amount": "unlimited",
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "cancel_open_orders_on_exit": false,
    "trading_mode": "futures",
    "margin_mode": "isolated",
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT:USDT",
            "ETH/USDT:USDT",
            "SOL/USDT:USDT",
            "XRP/USDT:USDT",
            "LTC/USDT:USDT",
            "DOT/USDT:USDT",
            "ADA/USDT:USDT",
            "AVAX/USDT:USDT",
            "LINK/USDT:USDT",
            "NEAR/USDT:USDT",
            "ARB/USDT:USDT",
            "OP/USDT:USDT",
            "APT/USDT:USDT",
            "SUI/USDT:USDT",
            "UNI/USDT:USDT",
            "ENA/USDT:USDT",
            "TAO/USDT:USDT",
            "ONDO/USDT:USDT",
            "POL/USDT:USDT",
            "1000PEPE/USDT:USDT",
            "WIF/USDT:USDT",
            "FET/USDT:USDT",
            "RENDER/USDT:USDT",
            "FIL/USDT:USDT",
            "LDO/USDT:USDT"
        ],
        "pair_blacklist": [
            "GIGGLE/USDT",
            "BARD/USDT",
            "BIO/USDT",
            "WLFI/USDT",
            "\u5e01\u5b89\u4eba\u751f/USDT",
            "D/USDT",
            "CHIP/USDT",
            "SOMI/USDT",
            "ZBT/USDT"
        ],
        "_key_note": "Set via FREQTRADE__EXCHANGE__KEY env var in freqtrade/.env (gitignored)"
    },
    "pairlists": [
        {
            "method": "StaticPairList"
        }
    ],
    "telegram": {
        "enabled": true,
        "token": "REPLACED_BY_ENV__see_freqtrade/.env",
        "chat_id": "5622292536"
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": true,
        "jwt_secret_key": "REPLACED_BY_ENV__see_freqtrade/.env",
        "username": "REPLACED_BY_ENV",
        "password": "REPLACED_BY_ENV"
    },
    "bot_name": "freqtrade",
    "initial_state": "running",
    "force_entry_enable": true,
    "strategy": "CortexaAI_v23",
    "strategy_path": "user_data/strategies",
    "internals": {
        "process_throttle_secs": 5
    },
    "stoploss": -0.04,
    "webhook": {
        "enabled": false,
        "url": "https://n8n.star7gaurav.in/webhook/freqtrade-events",
        "webhookstatus": {
            "type": "status",
            "status": "{status}"
        },
        "webhookentry": {
            "type": "buy",
            "pair": "{pair}",
            "open_rate": "{open_rate}",
            "stake_amount": "{stake_amount}"
        },
        "webhookexit": {
            "type": "sell",
            "pair": "{pair}",
            "profit_ratio": "{profit_ratio}",
            "profit_abs": "{profit_abs}",
            "close_rate": "{close_rate}"
        },
        "_note": "Disabled 2026-05-10: N8N permanently disabled. Re-enable when self-hosted webhook receiver is built."
    },
    "freqai": {
        "enabled": true,
        "purge_old_models": false,
        "train_period_days": 90,
        "backtest_period_days": 7,
        "live_retrain_hours": 4,
        "identifier": "finbuddy_v23_tf1h_1782044602",
        "feature_parameters": {
            "include_timeframes": [
                "4h",
                "1d"
            ],
            "include_corr_pairlist": [
                "BTC/USDT:USDT"
            ],
            "label_period_candles": 6,
            "include_shifted_candles": 2,
            "indicator_periods_candles": [
                10,
                20,
                50
            ],
            "DI_threshold": 0,
            "use_SVM_to_remove_outliers": false,
            "svm_params": {
                "nu": 0.05
            },
            "principal_component_analysis": false
        },
        "data_split_parameters": {
            "test_size": 0.15
        },
        "model_training_parameters": {
            "n_estimators": 100,
            "learning_rate": 0.03,
            "num_threads": 2,
            "min_child_samples": 50,
            "num_leaves": 31,
            "reg_alpha": 0.1,
            "reg_lambda": 0.1
        }
    },
    "freqaimodel": "LightGBMRegressor",
    "timeframe": "1h",
    "minimal_roi": {
        "0": 0.99
    },
    "startup_candle_count": 600,
    "position_adjustment_enable": true
}
