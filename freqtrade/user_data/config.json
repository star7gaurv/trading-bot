{
    "$schema": "https://schema.freqtrade.io/schema.json",
    "max_open_trades": 4,
    "stake_currency": "USDT",
    "stake_amount": 200,
    "tradable_balance_ratio": 0.99,
    "fiat_display_currency": "USD",
    "dry_run": true,
    "dry_run_wallet": 1000,
    "cancel_open_orders_on_exit": false,
    "trading_mode": "spot",
    "margin_mode": "",
    "unfilledtimeout": {
        "entry": 10,
        "exit": 10,
        "exit_timeout_count": 0,
        "unit": "minutes"
    },
    "entry_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1,
        "price_last_balance": 0.0,
        "check_depth_of_market": {
            "enabled": false,
            "bids_to_ask_delta": 1
        }
    },
    "exit_pricing": {
        "price_side": "same",
        "use_order_book": true,
        "order_book_top": 1
    },
    "exchange": {
        "name": "binance",
        "key": "",
        "secret": "",
        "ccxt_config": {},
        "ccxt_async_config": {},
        "pair_whitelist": [
            "BTC/USDT",
            "ETH/USDT"
        ],
        "pair_blacklist": [
            "BNB/.*",
            "GIGGLE/USDT",
            "BARD/USDT",
            "BIO/USDT",
            "WLFI/USDT",
            "\u5e01\u5b89\u4eba\u751f/USDT",
            "D/USDT",
            "CHIP/USDT",
            "SOMI/USDT",
            "ZBT/USDT"
        ]
    },
    "pairlists": [
        {
            "method": "VolumePairList",
            "number_assets": 30,
            "sort_key": "quoteVolume",
            "min_value": 5000000,
            "refresh_period": 1800
        },
        {
            "method": "SpreadFilter",
            "max_spread_ratio": 0.005
        },
        {
            "method": "PriceFilter",
            "low_price_ratio": 0.01,
            "min_price": 0.01
        },
        {
            "method": "RangeStabilityFilter",
            "lookback_days": 3,
            "min_rate_of_change": 0.05,
            "refresh_period": 1440
        },
        {
            "method": "VolatilityFilter",
            "lookback_days": 3,
            "min_volatility": 0.02,
            "max_volatility": 0.75,
            "refresh_period": 86400
        },
        {
            "method": "ShuffleFilter",
            "seed": 42
        }
    ],
    "telegram": {
        "enabled": false,
        "token": "8557119080:AAH9KPMIZSGP7Gsn9wbJGVNaNRyEQHISR_o",
        "chat_id": "5622292536"
    },
    "api_server": {
        "enabled": true,
        "listen_ip_address": "0.0.0.0",
        "listen_port": 8080,
        "verbosity": "error",
        "enable_openapi": true,
        "jwt_secret_key": "REDACTED-FREQTRADE__API_SERVER__JWT_SECRET_KEY",
        "username": "bot",
        "password": "REDACTED-FREQTRADE__API_SERVER__PASSWORD"
    },
    "bot_name": "freqtrade",
    "initial_state": "running",
    "force_entry_enable": true,
    "strategy": "FinBuddyFreqAI",
    "strategy_path": "user_data/strategies",
    "internals": {
        "process_throttle_secs": 5
    },
    "stoploss": -0.03,
    "webhook": {
        "enabled": false,
        "url": "https://n8n.star7gaurav.in/webhook/freqtrade-events",
        "webhookbuy": {
            "type": "buy",
            "pair": "{pair}",
            "open_rate": "{open_rate}",
            "stake_amount": "{stake_amount}"
        },
        "webhooksell": {
            "type": "sell",
            "pair": "{pair}",
            "profit_ratio": "{profit_ratio}",
            "profit_abs": "{profit_abs}",
            "close_rate": "{close_rate}"
        },
        "webhookstatus": {
            "type": "status",
            "status": "{status}"
        }
    },
    "freqai": {
        "enabled": false,
        "purge_old_models": true,
        "train_period_days": 30,
        "backtest_period_days": 7,
        "live_retrain_hours": 4,
        "identifier": "finbuddy_lgbm_v1",
        "feature_parameters": {
            "include_timeframes": [
                "15m"
            ],
            "include_corr_pairlist": [
                "BTC/USDT"
            ],
            "label_period_candles": 3,
            "include_shifted_candles": 2
        },
        "data_split_parameters": {
            "test_size": 0.15
        },
        "model_training_parameters": {
            "n_estimators": 100,
            "learning_rate": 0.05
        }
    },
    "freqaimodel": "PyTorchMLPRegressor"
}