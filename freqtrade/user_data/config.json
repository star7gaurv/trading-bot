{
  "$schema": "https://schema.freqtrade.io/schema.json",
  "max_open_trades": 4,
  "stake_currency": "USDT",
  "stake_amount": 200,
  "tradable_balance_ratio": 0.99,
  "fiat_display_currency": "USD",
  "dry_run": true,
  "dry_run_wallet": 1000,
  "cancel_open_orders_on_exit": false,
  "trading_mode": "futures",
  "margin_mode": "isolated",
  "unfilledtimeout": {
    "entry": 10,
    "exit": 10,
    "exit_timeout_count": 0,
    "unit": "minutes"
  },
  "entry_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1,
    "price_last_balance": 0.0,
    "check_depth_of_market": {
      "enabled": false,
      "bids_to_ask_delta": 1
    }
  },
  "exit_pricing": {
    "price_side": "same",
    "use_order_book": true,
    "order_book_top": 1
  },
  "exchange": {
    "name": "binance",
    "key": "",
    "secret": "",
    "ccxt_config": {},
    "ccxt_async_config": {},
    "pair_whitelist": [
      "BTC/USDT:USDT",
      "ETH/USDT:USDT"
    ],
    "pair_blacklist": [
      "BNB/.*",
      "GIGGLE/USDT",
      "BARD/USDT",
      "BIO/USDT",
      "WLFI/USDT",
      "\u5e01\u5b89\u4eba\u751f/USDT",
      "D/USDT",
      "CHIP/USDT",
      "SOMI/USDT",
      "ZBT/USDT"
    ]
  },
  "pairlists": [
    {
      "method": "VolumePairList",
      "number_assets": 30,
      "sort_key": "quoteVolume",
      "min_value": 5000000,
      "refresh_period": 1800
    },
    {
      "method": "SpreadFilter",
      "max_spread_ratio": 0.005
    },
    {
      "method": "PriceFilter",
      "low_price_ratio": 0.01,
      "min_price": 0.01
    },
    {
      "method": "RangeStabilityFilter",
      "lookback_days": 3,
      "min_rate_of_change": 0.05,
      "refresh_period": 1440
    },
    {
      "method": "VolatilityFilter",
      "lookback_days": 3,
      "min_volatility": 0.02,
      "max_volatility": 0.75,
      "refresh_period": 86400
    },
    {
      "method": "ShuffleFilter",
      "seed": 42
    }
  ],
  "telegram": {
    "enabled": true,
    "token": "",
    "chat_id": "5622292536",
    "_token_note": "REDACTED in repo. Live token is set on server only \u2014 paste into the on-server config or supply via env. Rotate via @BotFather: this token was previously committed."
  },
  "api_server": {
    "enabled": true,
    "listen_ip_address": "0.0.0.0",
    "listen_port": 8080,
    "verbosity": "error",
    "enable_openapi": true,
    "jwt_secret_key": "57dcf97ac3d5c933cd317d50ffd8ddf26422a99da3086a2518e31531ff5e6d95",
    "username": "bot",
    "password": "bot123"
  },
  "bot_name": "freqtrade",
  "initial_state": "running",
  "force_entry_enable": true,
  "strategy": "FinBuddyFreqAI",
  "strategy_path": "user_data/strategies",
  "internals": {
    "process_throttle_secs": 5
  },
  "stoploss": -0.03,
  "webhook": {
    "enabled": true,
    "url": "https://n8n.star7gaurav.in/webhook/freqtrade-events",
    "webhookstatus": {
      "type": "status",
      "status": "{status}"
    },
    "webhookentry": {
      "type": "buy",
      "pair": "{pair}",
      "open_rate": "{open_rate}",
      "stake_amount": "{stake_amount}"
    },
    "webhookexit": {
      "type": "sell",
      "pair": "{pair}",
      "profit_ratio": "{profit_ratio}",
      "profit_abs": "{profit_abs}",
      "close_rate": "{close_rate}"
    }
  },
  "freqai": {
    "enabled": true,
    "purge_old_models": true,
    "train_period_days": 30,
    "backtest_period_days": 7,
    "live_retrain_hours": 4,
    "identifier": "finbuddy_lgbm_v1",
    "feature_parameters": {
      "include_timeframes": [
        "15m"
      ],
      "include_corr_pairlist": [
        "BTC/USDT"
      ],
      "label_period_candles": 3,
      "include_shifted_candles": 2,
      "indicator_periods_candles": [
        10,
        20,
        50
      ]
    },
    "data_split_parameters": {
      "test_size": 0.15
    },
    "model_training_parameters": {
      "n_estimators": 100,
      "learning_rate": 0.05
    }
  },
  "freqaimodel": "LightGBMClassifier",
  "_freqaimodel_note": "Set to LightGBMClassifier to match v11 strategy (proba columns -1.0 / 1.0). FinBuddyLLMModel is a Regressor and is incompatible with v11; rewrite as Classifier subclass before re-enabling."
}